# --- GridIron configuration (copy to .env and fill in) ---

# Fernet key for encrypting Yahoo tokens + ESPN cookies at rest.
# Generate once:  uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key means re-entering ESPN cookies and re-doing Yahoo OAuth.
GRIDIRON_SECRET_KEY=

# Yahoo developer app credentials (https://developer.yahoo.com/apps/)
# Yahoo requires https on every redirect URI (plain http://localhost is rejected),
# so both the dev machine and the iMac need a Tailscale-issued https hostname:
# run `tailscale serve --bg 8000` on each (setup-imac.sh already does this for the
# iMac; run it manually on the M4 too), then register BOTH:
#   dev:  https://<m4>.<tailnet>.ts.net/api/connections/yahoo/callback
#   prod: https://<imac>.<tailnet>.ts.net/api/connections/yahoo/callback
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Base URL this instance is reached at (used to build the OAuth redirect) — must be
# the same https tailnet URL registered with Yahoo above, on both machines.
# dev machine: https://<m4>.<tailnet>.ts.net   iMac: https://<imac>.<tailnet>.ts.net
GRIDIRON_BASE_URL=https://<m4>.<tailnet>.ts.net

# ESPN unofficial API host — override if ESPN moves it.
ESPN_BASE_URL=https://lm-api-reads.fantasy.espn.com

# Scheduler: off in dev by default (trigger refreshes via POST /api/admin/refresh).
GRIDIRON_SCHEDULER_ENABLED=false

# SQLite location (created on boot).
GRIDIRON_DB_PATH=data/gridiron.db

# Rotated file logging (task 11.3): empty (default) = console-only, dev behavior
# unchanged. On the iMac, deploy/com.gridiron.app.plist sets this to
# ~/Library/Logs/gridiron so app + scheduler logs are also rotated to disk (5 MB x 5).
GRIDIRON_LOG_DIR=
