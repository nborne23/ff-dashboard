{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "GRIDIRON_SCHEDULER_ENABLED=false uv run uvicorn backend.main:app --port 8000"
      ],
      "port": 8000
    }
  ]
}
